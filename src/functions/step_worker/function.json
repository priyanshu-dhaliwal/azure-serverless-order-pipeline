{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "msg",
      "type": "serviceBusTrigger",
      "direction": "in",
      "connection": "SERVICEBUS_CONNECTION",
      "queueName": "%SESSION_QUEUE%",
      "isSessionsEnabled": true,
      "autoComplete": false,
      "maxAutoLockRenewalDuration": "00:05:00",
      "clientRetryOptions": {
        "mode": "exponential",
        "tryTimeout": "00:01:00",
        "delay": "00:00:02",
        "maxDelay": "00:01:00",
        "maxRetries": 5
      }
    }
  ]
}
